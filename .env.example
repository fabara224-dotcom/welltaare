APP_NAME="COMPLEXE WELLTAARÉ COLLECTION"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@welltaare.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false



# --- WELLTAARÉ ---
SHOP_NAME="COMPLEXE WELLTAARÉ COLLECTION"
APP_TIMEZONE=Africa/Conakry
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@welltaare.com
ADMIN_PASSWORD="ChangezMoi2026!"
# Adresse secrète de l'espace admin : https://votre-site.com/gestion/login
ADMIN_PATH=gestion
# Produits de démonstration : false = catalogue vide, l'admin ajoute tous les produits
SEED_DEMO=false

# Compte développeur (espace /gestion/dev) — ou : php artisan welltaare:developpeur votre@email.com
DEV_NAME="Développeur"
DEV_EMAIL=
DEV_PASSWORD=

# --- Orange Money Web Payment ---
ORANGE_MONEY_ENABLED=true
ORANGE_MONEY_MODE=sandbox
ORANGE_MONEY_AUTH_HEADER="Basic VOTRE_CLE_BASE64"
ORANGE_MONEY_MERCHANT_KEY=VOTRE_MERCHANT_KEY
ORANGE_MONEY_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_CURRENCY=OUV
ORANGE_MONEY_REFERENCE=WELLTAARE
